body {
  background-color: #FAF6EA;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="1440" height="900" viewBox="0 0 1440 900"><defs><radialGradient id="yellow-grad" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="%23FFF3C4"/><stop offset="70%" stop-color="%23F8E49B"/><stop offset="100%" stop-color="%23EBD27A"/></radialGradient><radialGradient id="purple-grad" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="%23ECE3F5"/><stop offset="70%" stop-color="%23D0C1E5"/><stop offset="100%" stop-color="%23B5A2D0"/></radialGradient><radialGradient id="center-grad" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="%23B08B67"/><stop offset="100%" stop-color="%23856241"/></radialGradient><!-- Realistic Yellow Cup Flower --><g id="real-yellow-flower"><animateTransform attributeName="transform" type="rotate" values="-3 0 0; 3 0 0; -3 0 0" dur="6s" repeatCount="indefinite" additive="sum"/><path d="M 0,0 C -8,-25 -18,-45 -22,-70" stroke="%239EAD87" stroke-width="1.3" fill="none"/><path d="M -10,-35 C -20,-38 -22,-28 -14,-22 Z" fill="%23B0C29A" opacity="0.6"/><g transform="translate(-22, -70)"><path d="M -22,-28 C -30,-8 -12,18 0,18 C 12,18 30,-8 22,-28 C 12,-12 -12,-12 -22,-28 Z" fill="url(%23yellow-grad)" opacity="0.65"/><path d="M -16,-32 C -24,-12 -8,10 0,10 C 8,10 24,-12 16,-32 C 8,-18 -8,-18 -16,-32 Z" fill="%23FFF9E0" opacity="0.5"/><circle cx="0" cy="-2" r="4.5" fill="url(%23center-grad)" opacity="0.7"/><path d="M -3,-8 L -5,-12 M 0,-9 L 0,-14 M 3,-8 L 5,-12 M -6,-4 L -11,-6 M 6,-4 L 11,-6" stroke="%23E5C860" stroke-width="0.8" stroke-linecap="round" opacity="0.6"/></g></g><!-- Realistic 8-Petal Purple Cosmos --><g id="real-purple-cosmos"><animateTransform attributeName="transform" type="rotate" values="4 0 0; -4 0 0; 4 0 0" dur="7.5s" repeatCount="indefinite" additive="sum"/><path d="M 0,0 C 12,-30 18,-55 12,-85" stroke="%2391A27B" stroke-width="1.2" fill="none"/><path d="M 6,-38 C 16,-42 22,-32 14,-26" stroke="%2391A27B" stroke-width="1" fill="none"/><g transform="translate(12, -85)"><g fill="url(%23purple-grad)" opacity="0.65"><path d="M -5,-5 C -8,-22 0,-28 5,-28 C 10,-28 12,-22 5,-5 Z"/><path d="M 5,-5 C 22,-8 28,0 28,5 C 28,10 22,12 5,5 Z"/><path d="M 5,5 C 8,22 0,28 -5,28 C -10,28 -12,22 -5,5 Z"/><path d="M -5,5 C -22,8 -28,0 -28,-5 C -28,-10 -22,-12 -5,-5 Z"/><path d="M -4,-5 C -18,-18 -22,-10 -18,-4 C -14,2 -6,-2 -4,-5 Z"/><path d="M 4,-5 C 18,-18 22,-10 18,-4 C 14,2 6,-2 4,-5 Z"/><path d="M 4,5 C 18,18 22,10 18,4 C 14,-2 6,2 4,5 Z"/><path d="M -4,5 C -18,18 -22,10 -18,4 C -14,-2 -6,2 -4,5 Z"/></g><circle cx="0" cy="0" r="5" fill="%23F3DF93" opacity="0.7"/><circle cx="0" cy="0" r="3" fill="url(%23center-grad)" opacity="0.7"/></g></g><!-- Branching Yellow Sprig --><g id="real-yellow-branch"><animateTransform attributeName="transform" type="rotate" values="-2.5 0 0; 2.5 0 0; -2.5 0 0" dur="6.8s" repeatCount="indefinite" additive="sum"/><path d="M 0,0 Q -18,-30 -35,-55 T -55,-100" stroke="%239EAD87" stroke-width="1.2" fill="none"/><path d="M -26,-42 Q -8,-52 8,-58" stroke="%239EAD87" stroke-width="1" fill="none"/><path d="M -42,-72 Q -28,-80 -18,-82" stroke="%239EAD87" stroke-width="0.8" fill="none"/><g transform="translate(-55, -100)"><ellipse cx="0" cy="0" rx="8" ry="5" fill="url(%23yellow-grad)" opacity="0.65" transform="rotate(-20)"/><circle cx="0" cy="0" r="1.8" fill="%23856241" opacity="0.6"/></g><g transform="translate(8, -58)"><ellipse cx="0" cy="0" rx="6" ry="4" fill="url(%23yellow-grad)" opacity="0.65" transform="rotate(15)"/></g><g transform="translate(-18, -82)"><ellipse cx="0" cy="0" rx="5" ry="3.5" fill="url(%23yellow-grad)" opacity="0.65" transform="rotate(-10)"/></g></g><!-- Purple Bud Stem --><g id="real-purple-bud"><animateTransform attributeName="transform" type="rotate" values="-5 0 0; 5 0 0; -5 0 0" dur="5.2s" repeatCount="indefinite" additive="sum"/><path d="M 0,0 Q 10,-25 18,-50" stroke="%239EAD87" stroke-width="1" fill="none"/><g transform="translate(18, -50)"><path d="M -4,0 C -8,-8 0,-14 0,-14 C 0,-14 8,-8 4,0 C 2,4 -2,4 -4,0 Z" fill="url(%23purple-grad)" opacity="0.65"/><path d="M -5,4 C -3,0 0,-3 0,-3 C 0,-3 3,0 5,4 C 3,7 -3,7 -5,4 Z" fill="%239EAD87" opacity="0.6"/></g></g></defs><g stroke-linecap="round" stroke-linejoin="round"><!-- Left Floral Border (8 Elements) --><g><use href="%23real-yellow-branch" x="75" y="80" transform="scale(0.8) rotate(8, 75, 80)"/><use href="%23real-purple-cosmos" x="110" y="190" transform="scale(0.75) rotate(-12, 110, 190)"/><use href="%23real-yellow-flower" x="50" y="300" transform="scale(0.85) rotate(6, 50, 300)"/><use href="%23real-purple-bud" x="125" y="400" transform="rotate(18, 125, 400)"/><use href="%23real-yellow-branch" x="60" y="510" transform="scale(0.75) rotate(-15, 60, 510)"/><use href="%23real-purple-cosmos" x="105" y="620" transform="scale(0.8) rotate(10, 105, 620)"/><use href="%23real-yellow-flower" x="45" y="730" transform="scale(0.85) rotate(-8, 45, 730)"/><use href="%23real-purple-bud" x="120" y="840" transform="scale(0.9) rotate(12, 120, 840)"/></g><!-- Right Floral Border (Mirrored 8 Elements) --><g transform="translate(1440, 0) scale(-1, 1)"><use href="%23real-yellow-branch" x="75" y="80" transform="scale(0.8) rotate(8, 75, 80)"/><use href="%23real-purple-cosmos" x="110" y="190" transform="scale(0.75) rotate(-12, 110, 190)"/><use href="%23real-yellow-flower" x="50" y="300" transform="scale(0.85) rotate(6, 50, 300)"/><use href="%23real-purple-bud" x="125" y="400" transform="rotate(18, 125, 400)"/><use href="%23real-yellow-branch" x="60" y="510" transform="scale(0.75) rotate(-15, 60, 510)"/><use href="%23real-purple-cosmos" x="105" y="620" transform="scale(0.8) rotate(10, 105, 620)"/><use href="%23real-yellow-flower" x="45" y="730" transform="scale(0.85) rotate(-8, 45, 730)"/><use href="%23real-purple-bud" x="120" y="840" transform="scale(0.9) rotate(12, 120, 840)"/></g></g></svg>');
  background-repeat: repeat-y;
  background-position: top center;
  background-size: 100% auto;
  background-attachment: fixed;
}